# Database
DATABASE_URL="postgresql://takahim:takahim_dev_password@localhost:5433/takahim"
REDIS_URL="redis://localhost:6380"

# Auth
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long!!!!"
PASSWORD_SALT_ROUNDS=12

# SMTP (email OTP delivery + incident alerts)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Takahim Shift Manager <your-gmail-address@gmail.com>"

# Firebase Cloud Messaging (FCM)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_APP_ID="your-firebase-app-id"

# Optional: Analytics, monitoring
NEXT_PUBLIC_GA_ID=""

# Web Push (VAPID). Generate a keypair with:  npx web-push generate-vapid-keys
# The public key is served to the browser; the private key is server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
