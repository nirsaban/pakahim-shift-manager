# Production env for docker-compose.prod.yml. Copy to .env.prod on the VPS
# and fill in real values — .env.prod is gitignored, never commit it.

# Used by compose to build DATABASE_URL for both the postgres and app
# services — do not set DATABASE_URL/REDIS_URL here, compose sets those
# directly from the internal service names (postgres:5432, redis:6379).
POSTGRES_PASSWORD="change-me-to-a-long-random-value"

# Session signing — generate with: openssl rand -base64 48
JWT_SECRET="change-me"
PASSWORD_SALT_ROUNDS=12

# SMTP (email OTP delivery + incident alerts)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="your-address@yourdomain.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Takahim Shift Manager <your-address@yourdomain.com>"

# Seed: which email becomes the ADMIN user (used once, manually — see DEPLOY.md)
SEED_ADMIN_EMAIL="you@example.com"

# Firebase Cloud Messaging (FCM) — unused today, left for later
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# App
NEXT_PUBLIC_APP_URL="https://takahim.miltech.cloud"
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Optional: Analytics, monitoring
NEXT_PUBLIC_GA_ID=""
